# Required: configure the real value in local .env or FC environment variables.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Optional: Redis enables one-hour result caching.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600

# Optional: API limits and permitted browser origins.
MAX_UPLOAD_BYTES=10485760
MAX_RESUME_CHARS=12000
MAX_JD_CHARS=4000
CORS_ORIGINS=https://shentuyvlv.github.io,http://127.0.0.1:9000,http://localhost:9000
