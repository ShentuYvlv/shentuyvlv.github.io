# ------------------------------
# 必填配置
# ------------------------------

# 阿里云百炼 (通义千问) API Key
# 获取地址: https://bailian.console.aliyun.com/ -> API-KEY管理
DASHSCOPE_API_KEY=sk-6215ed176e3145d2a211fd625d582171
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ------------------------------
# 可选配置 (如果不填，代码会跳过缓存逻辑)
# ------------------------------

# Redis 地址 (本地开发通常是 127.0.0.1 或 localhost)
REDIS_HOST=127.0.0.1

# Redis 端口 (默认 6379)
REDIS_PORT=6379

# Redis 密码 (如果没有密码，请留空)
REDIS_PASSWORD=